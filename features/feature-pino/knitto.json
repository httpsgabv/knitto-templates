{
  "schemaVersion": 1,
  "type": "feature",
  "slug": "pino-logging",
  "name": "Pino Logging",
  "description": "Add a basic Pino logging setup.",
  "supports": ["nestjs"],
  "requires": [],
  "conflictsWith": [],
  "files": {
    "include": ["**/*"],
    "exclude": ["knitto.json"]
  },
  "operations": [
    {
      "type": "merge-package-json",
      "source": "package.json",
      "target": "package.json",
      "strategy": "safe-merge"
    },
    {
      "type": "copy-file",
      "source": "src/infra/logger/logger.module.ts",
      "target": "src/infra/logger/logger.module.ts",
      "renderVariables": true,
      "overwrite": false
    },
    {
      "type": "ast.nest.add-module-import",
      "target": "src/app.module.ts",
      "import": {
        "named": "LoggerModule",
        "from": "./infra/logger/logger.module"
      },
      "moduleName": "LoggerModule"
    },
    {
      "type": "ast.add-named-import",
      "target": "src/main.ts",
      "named": "Logger",
      "from": "nestjs-pino"
    }
  ]
}