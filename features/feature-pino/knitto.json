{
  "schemaVersion": 1,
  "type": "feature",
  "slug": "pino-logging",
  "name": "Pino Logging",
  "description": "Add a basic Pino logging setup.",
  "supports": ["nestjs"],
  "requires": [],
  "conflictsWith": [],
  "files": {
    "include": ["**/*"],
    "exclude": ["knitto.json"]
  },
  "operations": [
    {
      "type": "merge-package-json",
      "source": "package.json",
      "target": "package.json",
      "strategy": "safe-merge"
    },
    {
      "type": "copy-file",
      "source": "src/infra/logger/logger.module.ts",
      "target": "src/infra/logger/logger.module.ts",
      "renderVariables": true,
      "overwrite": false
    },
    {
      "type": "ast.nest.add-module-import",
      "target": "src/infra/app.module.ts",
      "import": {
        "named": "LoggerModule",
        "from": "src/infra/logger/logger.module"
      },
      "moduleName": "LoggerModule"
    },
    {
      "type": "ast.add-named-import",
      "target": "src/infra/main.ts",
      "named": "Logger",
      "from": "nestjs-pino"
    },
    {
      "type": "ast.nest.add-bootstrap-call",
      "target": "src/infra/main.ts",
      "appVar": "app",
      "call": {
        "method": "useLogger",
        "arguments": [
          {
            "kind": "call",
            "callee": {
              "kind": "member",
              "object": "app",
              "property": "get"
            },
            "arguments": [
              {
                "kind": "identifier",
                "name": "Logger"
              }
            ]
          }
        ]
      }
    }
  ]
}